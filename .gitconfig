[core]
	# Make `git rebase` safer on OS X
	# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
	trustctime = false
	editor = vim

[color "branch"]

	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]

	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions

[color "status"]

	added = yellow
	changed = green
	untracked = cyan

[diff]

	# Detect copies as well as renames
	renames = copies

[help]

	# Automatically correct and execute mistyped commands
	autocorrect = 1

[merge]

	# Include summaries of merged commits in newly created merge commit messages
	log = true

[push]
	# change to maching for machines with older versions of git 1.x.x
	default = simple
	autoSetupRemote = true

# SSH commit signing, backed by a Secure Enclave key held in Secretive.
#
# Two Secretive keys, deliberately:
#
#   - the default key, created with "Require Authentication", used for SSH auth
#     to GitHub. ControlMaster in ssh/config amortises it to roughly one Touch
#     ID per work session.
#
#   - a second key named `git-signing`, created with "Notify", used only for
#     commit signatures. Signing hits the Secure Enclave once per commit and
#     ControlMaster cannot amortise it the way it does for connections, so an
#     authentication-required key means a Touch ID tap on literally every
#     commit. "Notify" trades the per-signature consent prompt for a
#     notification. The key is still non-extractable either way.
#
# user.signingKey points at a public key FILE rather than a literal key, which
# is what the Secretive maintainer recommends (maxgoedjen/secretive#262). Git
# hands the file to ssh-keygen, which finds the matching private key in the
# agent. Two Secure Enclave keys are otherwise indistinguishable from outside
# the agent -- it exposes no metadata beyond the comment, and its ordering is
# not stable -- so selecting by file is the only unambiguous option.
#
# NOTE: a literal key here would need a `key::` prefix, because git only
# accepts a literal if it starts with `ssh-` or `key::` (is_literal_ssh_key in
# gpg-interface.c) and Secure Enclave keys are P-256, starting with `ecdsa-`.
# The file form sidesteps that entirely.
#
# NOTE: this file must exist or commits fail. macos/setup-signing.sh writes it,
# identifying the signing key by matching the agent against the signing keys
# registered on the GitHub account -- the SSH comment cannot be used, since
# Secretive reports the same one for every key here and renaming a secret does
# not change it.
#
# gpg.ssh.allowedSignersFile is set purely for LOCAL verification. Per git's
# gpg-interface it is read only by the verify path (ssh-keygen -Y
# find-principals / verify); the sign path never touches it, and GitHub checks
# the Verified badge server side against the Signing Key on the account. So it
# buys exactly one thing: `git log --show-signature` and %G? reporting `G`
# instead of refusing to check. Nothing depends on it, and deleting the file
# breaks verification only, never committing.
#
# The file maps a PRINCIPAL (a committer email) to a key, so it needs one line
# per identity you commit under, not one per key: an SSH key carries no email,
# so a single Secure Enclave key signs for all of them, and a commit authored
# by an address missing from this file verifies as unknown.
# macos/setup-signing.sh writes it -- do not hand-edit.
#
# NOTE: the signing key must be registered on GitHub as a *Signing* key. That
# list is separate from Authentication keys, and a key present only in the
# Authentication list produces valid signatures with no Verified badge.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[pull]
	rebase = true
[user]
	name = alexeyeryshev
	email = a.a.eryshev@gmail.com
	signingKey = ~/.ssh/git-signing.pub
[github]
	user = alexeyeryshev
# FIXME: learn about this
# [filter "lfs"]
# 	clean = git-lfs clean -- %f
# 	smudge = git-lfs smudge -- %f
# 	process = git-lfs filter-process
# 	required = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Machine-local git config, if there is any.
#
# Everything private to a machine goes here rather than in this file: extra
# identities and the includeIf rules that select them, host-specific paths,
# anything not worth publishing. This repo is public; that file is not in it.
#
# Position matters. Includes are applied where they appear and later values
# win, so this has to sit AFTER [user] or the identity above would override
# whatever the include sets, which is the whole point of it.
#
# Deliberately not ~/.config/git/config: git reads that one BEFORE ~/.gitconfig,
# so it loses every conflict with the values above -- the exact opposite of
# what is wanted here. An explicit include is the only ordering that works.
#
# A missing file is a silent no-op, so this stays valid on a fresh machine.
[include]
	path = ~/.config/git/local.gitconfig
