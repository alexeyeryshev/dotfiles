[core]
	# Make `git rebase` safer on OS X
	# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
	trustctime = false
	editor = vim

[color "branch"]

	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]

	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions

[color "status"]

	added = yellow
	changed = green
	untracked = cyan

[diff]

	# Detect copies as well as renames
	renames = copies

[help]

	# Automatically correct and execute mistyped commands
	autocorrect = 1

[merge]

	# Include summaries of merged commits in newly created merge commit messages
	log = true

[push]
	# change to maching for machines with older versions of git 1.x.x
	default = simple
	autoSetupRemote = true

# SSH commit signing, backed by the Secure Enclave key in Secretive.
#
# Deliberately pre-wired but NOT switched on: git errors out with "either
# user.signingkey or gpg.ssh.defaultKeyCommand needs to be configured" if
# signing is enabled before a key exists. defaultKeyCommand below takes the
# first key from the agent, so once Secretive holds one, this all just works.
#
# SSH commit signing, backed by the Secure Enclave key held in Secretive.
#
# defaultKeyCommand resolves the key from the agent at signing time, so no
# machine-specific key identity lives here and this works unchanged on a new
# machine holding a different key. Nothing needs provisioning after install.
#
# gpg.ssh.allowedSignersFile is deliberately NOT set. Per git's gpg-interface,
# it is read only by the verify path (ssh-keygen -Y find-principals / verify);
# the sign path never touches it, and GitHub checks the Verified badge server
# side against the Signing Key on the account. The only thing given up is local
# `git log --show-signature`, which will report signatures as unverified.
#
# NOTE: with gpgsign on, `git commit` fails until the agent holds a key.
[gpg]
	format = ssh
[gpg "ssh"]
	defaultKeyCommand = ssh-add -L
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[pull]
	rebase = true
[user]
	name = alexeyeryshev
	email = a.a.eryshev@gmail.com
	# signingkey = 18F3685C0022BFF3
[github]
	user = alexeyeryshev
# FIXME: learn about this
# [filter "lfs"]
# 	clean = git-lfs clean -- %f
# 	smudge = git-lfs smudge -- %f
# 	process = git-lfs filter-process
# 	required = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
