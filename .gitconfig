[core]
	# Make `git rebase` safer on OS X
	# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
	trustctime = false
	editor = vim

[color "branch"]

	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]

	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions

[color "status"]

	added = yellow
	changed = green
	untracked = cyan

[diff]

	# Detect copies as well as renames
	renames = copies

[help]

	# Automatically correct and execute mistyped commands
	autocorrect = 1

[merge]

	# Include summaries of merged commits in newly created merge commit messages
	log = true

[push]
	# change to maching for machines with older versions of git 1.x.x
	default = simple
	autoSetupRemote = true

# SSH commit signing, backed by the Secure Enclave key held in Secretive.
#
# defaultKeyCommand resolves the key from the agent at signing time, so no
# machine-specific key identity lives here and this works unchanged on a new
# machine holding a different key. Nothing needs provisioning after install.
#
# Two non-obvious things about the command below, both load-bearing:
#
#   1. It is wrapped in `sh -c`. Git does NOT run defaultKeyCommand through a
#      shell -- it splits the string into argv and execs it directly -- so a
#      bare `ssh-add -L | sed ...` hands sed's arguments to ssh-add, which
#      dies with "invalid option -- n".
#
#   2. The output is prefixed with `key::`. Git accepts a literal key here only
#      if it starts with `ssh-` or `key::` (is_literal_ssh_key in
#      gpg-interface.c). Secure Enclave keys are NIST P-256, so they start with
#      `ecdsa-` and are silently rejected without the prefix: git warns
#      "defaultKeyCommand succeeded but returned no keys" and the commit fails.
#
# gpg.ssh.allowedSignersFile is deliberately NOT set. Per git's gpg-interface,
# it is read only by the verify path (ssh-keygen -Y find-principals / verify);
# the sign path never touches it, and GitHub checks the Verified badge server
# side against the Signing Key on the account. The only thing given up is local
# `git log --show-signature`, which will report signatures as unverified.
#
# NOTE: with gpgsign on, `git commit` fails until the agent holds a key.
# NOTE: the public key must ALSO be registered on GitHub as a *Signing* key.
# That list is separate from Authentication keys, and a key present only in the
# Authentication list produces valid signatures with no Verified badge.
[gpg]
	format = ssh
[gpg "ssh"]
	defaultKeyCommand = sh -c 'ssh-add -L | sed -n 1s/^/key::/p'
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[pull]
	rebase = true
[user]
	name = alexeyeryshev
	email = a.a.eryshev@gmail.com
	# signingkey = 18F3685C0022BFF3
[github]
	user = alexeyeryshev
# FIXME: learn about this
# [filter "lfs"]
# 	clean = git-lfs clean -- %f
# 	smudge = git-lfs smudge -- %f
# 	process = git-lfs filter-process
# 	required = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
