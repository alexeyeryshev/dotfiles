export EDITOR=vim

# Proprieatry config
if [ -f ~/.zshrc.custom.proprietary ]; then
  source ~/.zshrc.custom.proprietary
fi

# Utilities
gu () {
  git add --all && git commit -am "$argv[1]" && git push
}

source_env () {
  set -a
  source .env
  set +a
}

# pnpm
export PNPM_HOME="${HOME}/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# UV managed
export PATH="$HOME/.local/bin:$PATH"

# Custom bin
export PATH="$HOME/.bin:$PATH"

# Custom XDG_CONFIG_HOME
export XDG_CONFIG_HOME="$HOME/.config"

# export gpg for gpg2  
export GPG_TTY=$(tty)

# Secretive - SSH agent backed by the Secure Enclave.
# Guarded so these dotfiles stay valid on a machine without it.
_secretive_sock="$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
[ -S "$_secretive_sock" ] && export SSH_AUTH_SOCK="$_secretive_sock"
unset _secretive_sock

# Warp tab title. Warp seeds ZSH_THEME_TERM_TITLE_IDLE="%~" before it sources
# ~/.zshrc, then oh-my-zsh's termsupport overwrites it with "%n@%m:%~", putting
# user@host in every tab -- a constant that never changes, and long enough that
# Warp's 25-char truncation then eats the front of the path. Put it back. Warp
# uses a separate variable over SSH, so the host still shows where it matters.
ZSH_THEME_TERM_TITLE_IDLE="%~"

# mise - per-directory tool versions. Activation hooks the prompt, so PATH is
# recomputed on every `cd`: a repo's mise.toml applies inside its own tree and
# nowhere else. Outside one, a tool may still run through the shim, at whatever
# version happens to be installed -- unpinned, not absent.
#
# Without activation, `node` and friends resolve to whatever else is on PATH,
# which matches the pin often enough to hide the problem until it does not.
#
# Editors and GUI git clients never source this file. They need the SHIM
# directory on PATH instead: ~/.local/share/mise/shims
#
# NOT guarded silently: a missing mise means every pinned tool falls back to
# whatever else is on PATH, which is the failure this line exists to prevent.
# Say so instead.
if command -v mise >/dev/null; then
  eval "$(mise activate zsh)"
else
  print -u2 "zshrc.custom: mise is not installed, so tool versions are unpinned. brew install mise"
fi
